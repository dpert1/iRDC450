[
  {
    "id": "prc-1",
    "column": "left",
    "title": "Equation 1: Separative Work Units (SWU)",
    "equations": [
      "\\[SWU = [P \\cdot V(x_p) + W \\cdot V(x_w) - F \\cdot V(x_f)] \\tau \\quad \\text{[kg-SWU]}\\]"
    ],
    "variables": [
      {
        "sym": "\\(SWU\\)",
        "def": "Separative work units [kg-SWU]"
      },
      {
        "sym": "\\(P\\)",
        "def": "Product flow rate [kg/time]"
      },
      {
        "sym": "\\(W\\)",
        "def": "Waste (tails) flow rate [kg/time]"
      },
      {
        "sym": "\\(F\\)",
        "def": "Feed flow rate [kg/time]"
      },
      {
        "sym": "\\(V(x_i)\\)",
        "def": "Separation potential \\(x_i\\) [SWU]"
      },
      {
        "sym": "\\(x_p\\)",
        "def": "Product enrichment (mass fraction) [-]"
      },
      {
        "sym": "\\(x_w\\)",
        "def": "Waste enrichment (mass fraction) [-]"
      },
      {
        "sym": "\\(x_f\\)",
        "def": "Feed enrichment (mass fraction) [-]"
      },
      {
        "sym": "\\(\\tau\\)",
        "def": "Time period [time]"
      }
    ],
    "description": [
      {
        "p": "Separative work units quantify the effort required in isotope separation processes. The separation potential, V(x), represents the work needed to enrich material to a given concentration. Generally, we will consider time to be unity, so \\(\\tau\\) = 1 and the flow rates will become masses by unit cancellation."
      }
    ]
  },
  {
    "id": "prc-2-1",
    "column": "left",
    "title": "Equation 2-1: Feed Factor",
    "equations": [
      "\\[\\frac{F}{P} = \\frac{x_p - x_w}{x_f - x_w}\\]"
    ],
    "variables": [
      {
        "sym": "\\(F\\)",
        "def": "Feed flow rate [kg/time]"
      },
      {
        "sym": "\\(P\\)",
        "def": "Product flow rate [kg/time]"
      },
      {
        "sym": "\\(x_p\\)",
        "def": "Product enrichment (mass fraction) [-]"
      },
      {
        "sym": "\\(x_w\\)",
        "def": "Waste enrichment (mass fraction) [-]"
      },
      {
        "sym": "\\(x_f\\)",
        "def": "Feed enrichment (mass fraction) [-]"
      }
    ],
    "description": [
      {
        "p": "The feed factor relates the feed and product flow rates in an isotope separation cascade based on their respective enrichment levels."
      }
    ]
  },
  {
    "id": "prc-2-2",
    "column": "left",
    "title": "Equation 2-2: Waste Factor",
    "equations": [
      "\\[\\frac{W}{P} = \\frac{x_p - x_f}{x_f - x_w}\\]"
    ],
    "variables": [
      {
        "sym": "\\(W\\)",
        "def": "Waste (tails) flow rate [kg/time]"
      },
      {
        "sym": "\\(P\\)",
        "def": "Product flow rate [kg/time]"
      },
      {
        "sym": "\\(x_p\\)",
        "def": "Product enrichment (mass fraction) [-]"
      },
      {
        "sym": "\\(x_w\\)",
        "def": "Waste enrichment (mass fraction) [-]"
      },
      {
        "sym": "\\(x_f\\)",
        "def": "Feed enrichment (mass fraction) [-]"
      }
    ],
    "description": [
      {
        "p": "The waste factor relates the waste and product flow rates in an isotope separation cascade based on their respective enrichment levels."
      }
    ]
  },
  {
    "id": "prc-3",
    "column": "left",
    "title": "Equation 3: Separation Potential V(x<sub>i</sub>)",
    "equations": [
      "\\[V(x_i) = (2x_i - 1) \\ln\\left(\\frac{x_i}{1 - x_i}\\right) \\quad \\text{[SWU]}\\]"
    ],
    "variables": [
      {
        "sym": "\\(V(x_i)\\)",
        "def": "Value function at enrichment \\(x_i\\) [SWU]"
      },
      {
        "sym": "\\(x_i\\)",
        "def": "Enrichment (mass fraction) of stream i [-]"
      }
    ],
    "description": [
      {
        "p": "The value function quantifies the separative work content of material at a given enrichment level. It appears in the SWU calculation and represents the difficulty of achieving a particular enrichment. The separation potential will need to be found for all three streams (feed, product, and waste) when calculating SWU."
      }
    ]
  },
  {
    "id": "prc-4",
    "column": "left",
    "title": "Equation 4: Number of Stages in Cascade",
    "equations": [
      "\\[N = \\frac{2}{\\ln \\alpha} \\ln\\left(\\frac{x_p(1 - x_w)}{x_w(1 - x_p)}\\right) - 1\\]"
    ],
    "variables": [
      {
        "sym": "\\(N\\)",
        "def": "Number of ideal stages [-]"
      },
      {
        "sym": "\\(\\alpha\\)",
        "def": "Separation factor [-]"
      },
      {
        "sym": "\\(x_p\\)",
        "def": "Product enrichment (mass fraction) [-]"
      },
      {
        "sym": "\\(x_w\\)",
        "def": "Waste enrichment (mass fraction) [-]"
      }
    ],
    "description": [
      {
        "p": "This equation calculates the number of ideal separation stages required in a cascade to achieve desired product and waste enrichments given a specific separation factor."
      }
    ]
  },
  {
    "id": "prc-5",
    "column": "left",
    "title": "Equation 5: Gaseous Diffusion Separation Factor",
    "equations": [
      "\\[\\alpha = \\sqrt{\\frac{m_H}{m_L}}\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\alpha\\)",
        "def": "Separation factor [-]"
      },
      {
        "sym": "\\(m_H\\)",
        "def": "Mass of heavy molecule [amu]"
      },
      {
        "sym": "\\(m_L\\)",
        "def": "Mass of light molecule [amu]"
      }
    ],
    "description": [
      {
        "p": "The gaseous diffusion seperation factor is based on the square root of the mass ratio of molecules being seperated. This only applies to gaseous diffusion."
      }
    ]
  },
  {
    "id": "prc-6",
    "column": "left",
    "title": "Equation 6: Centrifuge Separation Factor",
    "equations": [
      "\\[\\alpha = \\exp\\left(\\frac{(m_H - m_L) \\omega^2 r^2}{2R_UT}\\right)\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\alpha\\)",
        "def": "Separation factor [-]"
      },
      {
        "sym": "\\(m_H\\)",
        "def": "Mass of heavy molecule [kg/mol]"
      },
      {
        "sym": "\\(m_L\\)",
        "def": "Mass of light molecule [kg/mol]"
      },
      {
        "sym": "\\(\\omega\\)",
        "def": "Angular velocity [rad/s]"
      },
      {
        "sym": "\\(r\\)",
        "def": "Radius from axis of rotation [m]"
      },
      {
        "sym": "\\(R_U\\)",
        "def": "Universal gas constant [J/(mol·K)]"
      },
      {
        "sym": "\\(T\\)",
        "def": "Temperature [K]"
      }
    ],
    "description": [
      {
        "p": "Separation factor for gas centrifuge enrichment, which depends on the mass difference, centrifuge speed, radius, and temperature. Higher speeds and larger radii increase separation."
      }
    ]
  },
  {
    "id": "prc-7",
    "column": "left",
    "title": "Equation 7: Multiplication Factor",
    "equations": [
      "\\[k_\\infty = \\nu \\frac{\\Sigma_f}{\\Sigma_a} = \\nu \\frac{\\sigma_f}{\\sigma_a}\\]",
      "\\[k = k_\\infty L\\]"
    ],
    "variables": [
      {
        "sym": "\\(k_\\infty\\)",
        "def": "Infinite multiplication factor [-]"
      },
      {
        "sym": "\\(\\nu\\)",
        "def": "Average number of neutrons per fission [-]"
      },
      {
        "sym": "\\(\\Sigma_f\\)",
        "def": "Macroscopic fission cross section [cm<sup>-1</sup>]"
      },
      {
        "sym": "\\(\\Sigma_a\\)",
        "def": "Macroscopic absorption cross section [cm<sup>-1</sup>]"
      },
      {
        "sym": "\\(\\sigma_f\\)",
        "def": "Microscopic fission cross section [barns]"
      },
      {
        "sym": "\\(\\sigma_a\\)",
        "def": "Microscopic absorption cross section [barns]"
      },
      {
        "sym": "\\(k\\)",
        "def": "Effective multiplication factor [-]"
      },
      {
        "sym": "\\(L\\)",
        "def": "Non-leakage factor [-]"
      }
    ],
    "description": [
      {
        "p": "The infinite multiplication factor represents neutron multiplication in an infinite medium. The effective multiplication factor accounts for neutron leakage in finite systems."
      },
      {
        "p": "The second form, using microscopic cross sections, only holds when the fuel is a single nuclide. For a mixture (e.g., HEU containing both U-235 and U-238), sum over each nuclide i: \\(k_\\infty = \\sum_i \\nu_i N_i \\sigma_{f,i} \\,/\\, \\sum_i N_i \\sigma_{a,i}\\)."
      }
    ]
  },
  {
    "id": "prc-8",
    "column": "left",
    "title": "Equation 8: Neutron Lifetime",
    "equations": [
      "\\[l_\\infty = \\frac{\\lambda_a}{v} = \\frac{1}{\\Sigma_a v}\\]",
      "\\[l = l_\\infty L\\]"
    ],
    "variables": [
      {
        "sym": "\\(l_\\infty\\)",
        "def": "Infinite medium neutron lifetime [s]"
      },
      {
        "sym": "\\(\\lambda_a\\)",
        "def": "Absorption mean free path [cm]"
      },
      {
        "sym": "\\(v\\)",
        "def": "Neutron speed [cm/s]"
      },
      {
        "sym": "\\(\\Sigma_a\\)",
        "def": "Macroscopic absorption cross section [cm<sup>-1</sup>]"
      },
      {
        "sym": "\\(l\\)",
        "def": "Effective neutron lifetime [s]"
      },
      {
        "sym": "\\(L\\)",
        "def": "Non-leakage factor [-]"
      }
    ],
    "description": [
      {
        "p": "Infinite neutron lifetime represents the average time a neutron exists from birth (fission) to absorption in an infinite medium. The effective lifetime accounts for leakage losses in finite systems."
      }
    ]
  },
  {
    "id": "prc-9",
    "column": "left",
    "title": "Equation 9: Multiplication Rate (Bomb Alpha)",
    "equations": [
      "\\[\\alpha = \\frac{k - 1}{l}\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\alpha\\)",
        "def": "Multiplication rate [s<sup>-1</sup>]"
      },
      {
        "sym": "\\(k\\)",
        "def": "Effective multiplication factor [-]"
      },
      {
        "sym": "\\(l\\)",
        "def": "Effective neutron lifetime [s]"
      }
    ],
    "description": [
      {
        "p": "The multiplication rate (also called bomb alpha) determines the exponential rate of change of neutron population in a fissioning weapon core. Positive values indicate a supercritical state with increasing neutron population, whereas negative values indicate a subcritical state with decreasing neutron population."
      }
    ]
  },
  {
    "id": "prc-10-1",
    "column": "left",
    "title": "Equation 10-1: Neutron Population",
    "equations": [
      "\\[N(t) = N_0 e^{\\alpha t}\\]"
    ],
    "variables": [
      {
        "sym": "\\(N(t)\\)",
        "def": "Neutron population at time t [# of neutrons]"
      },
      {
        "sym": "\\(N_0\\)",
        "def": "Initial neutron population [# of neutrons]"
      },
      {
        "sym": "\\(\\alpha\\)",
        "def": "Multiplication rate (bomb alpha) [s<sup>-1</sup>]"
      },
      {
        "sym": "\\(t\\)",
        "def": "Time [s]"
      }
    ],
    "description": [
      {
        "p": "Neutron population describes the exponential growth (or decay) of neutrons in a fissioning system over time."
      }
    ]
  },
  {
    "id": "prc-10-2",
    "column": "left",
    "title": "Equation 10-2: Energy Yield",
    "equations": [
      "\\[Y(t) = \\frac{\\Sigma_f v Q N_0}{\\alpha} \\left(e^{\\alpha t} - 1\\right)\\]"
    ],
    "variables": [
      {
        "sym": "\\(Y(t)\\)",
        "def": "Energy yield at time t [MeV or kT]"
      },
      {
        "sym": "\\(\\Sigma_f\\)",
        "def": "Macroscopic fission cross section [cm<sup>-1</sup>]"
      },
      {
        "sym": "\\(v\\)",
        "def": "Neutron speed [cm/s]"
      },
      {
        "sym": "\\(Q\\)",
        "def": "Energy per fission [MeV or kT]"
      },
      {
        "sym": "\\(N_0\\)",
        "def": "Initial neutron population [# of neutrons]"
      },
      {
        "sym": "\\(\\alpha\\)",
        "def": "Multiplication rate (bomb alpha) [s<sup>-1</sup>]"
      },
      {
        "sym": "\\(t\\)",
        "def": "Time [s]"
      }
    ],
    "description": [
      {
        "p": "Energy yield describes the exponential growth (or decay) of accumulated energy yield in a fissioning system over time."
      }
    ]
  },
  {
    "id": "prc-11",
    "column": "left",
    "title": "Equation 11: Expansion Velocity",
    "equations": [
      "\\[\\frac{Y}{3} = \\frac{1}{2} M (u_2)^2\\]"
    ],
    "variables": [
      {
        "sym": "\\(Y\\)",
        "def": "Energy yield [J]"
      },
      {
        "sym": "\\(M\\)",
        "def": "Mass of material in the bomb core (fuel + tamper) [kg]"
      },
      {
        "sym": "\\(u_2\\)",
        "def": "Mean expansion velocity [m/s]"
      }
    ],
    "description": [
      {
        "p": "This relation connects the energy yield to the mass and expansion velocity of fissile material in a weapon."
      }
    ]
  },
  {
    "id": "prc-12",
    "column": "left",
    "title": "Equation 12: Compressed Cross Section",
    "equations": [
      "\\[\\Sigma = \\Sigma_0 \\left(\\frac{\\rho}{\\rho_0}\\right) \\left(1 - B_F + 2B_F \\frac{\\sigma_{ff}}{\\sigma_{fuel}}\\right)\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\Sigma\\)",
        "def": "Compressed macroscopic cross section [cm<sup>-1</sup>]"
      },
      {
        "sym": "\\(\\Sigma_0\\)",
        "def": "Initial macroscopic cross section [cm<sup>-1</sup>]"
      },
      {
        "sym": "\\(\\rho\\)",
        "def": "Compressed density [g/cm<sup>3</sup>]"
      },
      {
        "sym": "\\(\\rho_0\\)",
        "def": "Initial density [g/cm<sup>3</sup>]"
      },
      {
        "sym": "\\(B_F\\)",
        "def": "Burn-up factor [-]"
      },
      {
        "sym": "\\(\\sigma_{ff}\\)",
        "def": "Fission fragment cross section [barns or cm<sup>2</sup>]"
      },
      {
        "sym": "\\(\\sigma_{fuel}\\)",
        "def": "Fuel cross section [barns or cm<sup>2</sup>]"
      }
    ],
    "description": [
      {
        "p": "This equation accounts for the change in any macroscopic cross section when nuclear material is compressed and burned, considering both density changes and burn-up effects."
      }
    ]
  },
  {
    "id": "prc-13",
    "column": "left",
    "title": "Equation 13: Plutonium Non-Leakage Factor",
    "equations": [
      "\\[L_{Pu} = 0.43\\, m^{-0.15} \\ln C + 0.14 \\ln m \\qquad C = \\frac{\\rho}{\\rho_0}\\]"
    ],
    "variables": [
      {
        "sym": "\\(L_{Pu}\\)",
        "def": "Non-leakage factor for a fissioning plutonium sphere [-]"
      },
      {
        "sym": "\\(m\\)",
        "def": "Mass of plutonium fuel [kg]"
      },
      {
        "sym": "\\(C\\)",
        "def": "Compression ratio relative to nominal plutonium density [-]"
      },
      {
        "sym": "\\(\\rho\\)",
        "def": "Compressed density [g/cm<sup>3</sup>]"
      },
      {
        "sym": "\\(\\rho_0\\)",
        "def": "Nominal plutonium density, 19.85 [g/cm<sup>3</sup>]"
      }
    ],
    "description": [
      {
        "p": "This equation is an approximation for the non-leakage factor of a fissioning sphere of plutonium, based on data from Bridgman. It is ONLY a valid approximation for plutonium."
      },
      {
        "p": "Because this is a curve fit, only use it within the range of masses and compressions covered by the source data. Outside that range it gives non-physical results: for example, at \\(C = 1\\) it goes negative for \\(m < 1\\) kg because \\(\\ln m < 0\\)."
      }
    ]
  },
  {
    "id": "prc-14",
    "column": "left",
    "title": "Equation 14: Fusion Yield",
    "equations": [
      "\\[Y = N_{reac}Q\\]"
    ],
    "variables": [
      {
        "sym": "\\(Y\\)",
        "def": "Total energy yield [kT or MeV]"
      },
      {
        "sym": "\\(N_{reac}\\)",
        "def": "Number of fusion reactions [-]"
      },
      {
        "sym": "\\(Q\\)",
        "def": "Energy per fusion reaction [kT or MeV]"
      }
    ],
    "description": [
      {
        "p": "The total energy released from fusion is simply the number of reactions multiplied by the energy released per reaction."
      },
      {
        "p": "\\(Q_{DD} = 9.96\\) MeV (footnote to the thermonuclear reactions table) is an effective Q-value for D-D burning. It assumes the two D-D branches occur equally often and that the tritium from \\(D + D \\rightarrow T + H\\) also burns with deuterium, while the \\(^3\\text{He}\\) from \\(D + D \\rightarrow {}^3\\text{He} + n\\) does not: 4.03 + 3.27 + 17.6 = 24.9 MeV from 5 deuterons, or 4.98 MeV per deuteron. \\(Q_{DD}\\) is that per-deuteron average multiplied by 2, i.e. the energy per D-D reaction when the tritium burn is included."
      }
    ]
  },
  {
    "id": "prc-15",
    "column": "left",
    "title": "Equation 15: Fusion Yield in a Sphere",
    "equations": [
      "\\[Y = \\frac{4}{3} \\pi r^3 n_{tar} Q\\]"
    ],
    "variables": [
      {
        "sym": "\\(Y\\)",
        "def": "Total energy yield [J]"
      },
      {
        "sym": "\\(r\\)",
        "def": "Radius of fusion sphere [m]"
      },
      {
        "sym": "\\(n_{tar}\\)",
        "def": "Number density of target particles [targets/m<sup>3</sup>]"
      },
      {
        "sym": "\\(Q\\)",
        "def": "Energy per fusion reaction [J]"
      }
    ],
    "description": [
      {
        "p": "Energy yield from fusion reactions in a spherical volume, assuming complete burnup of target material."
      }
    ]
  },
  {
    "id": "prc-16-1",
    "column": "left",
    "title": "Equation 16-1: Fusion Reaction Rate Density",
    "equations": [
      "\\[\\hat{R}\\ = (\\overline{\\sigma v}) n_{tar} n_{bomb}\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\hat{R}\\)",
        "def": "Reaction rate density [reactions/(cm<sup>3</sup>·s)]"
      },
      {
        "sym": "\\((\\overline{\\sigma v})\\)",
        "def": "Reactivity (fusion cross section) [cm<sup>3</sup>/s]"
      },
      {
        "sym": "\\(n_{tar}\\)",
        "def": "Number density of target particles [particles/cm<sup>3</sup>]"
      },
      {
        "sym": "\\(n_{bomb}\\)",
        "def": "Number density of bombarding particles [particles/cm<sup>3</sup>]"
      }
    ],
    "description": [
      {
        "p": "Reaction rate density for fusion between two different species (e.g., D-T)."
      },
      {
        "p": "Note: for like-species fusion (D-D), every deuteron can act as either target or bombarder, and each pair may only be counted once, so the rate is \\(\\hat{R} = \\tfrac{1}{2}(\\overline{\\sigma v}) n_D^2\\). If you follow Equation 16-2 and split the deuterium into equal target and bombarding halves (\\(n_{tar} = n_{bomb} = n_D/2\\)), this is the same as multiplying Equation 16-1 by 2:"
      },
      {
        "eq": "\\[\\hat{R} = \\tfrac{1}{2}(\\overline{\\sigma v}) n_D^2 = 2(\\overline{\\sigma v}) n_{tar} n_{bomb}\\]"
      },
      {
        "p": "Use one form or the other. Setting \\(n_{tar} = n_{bomb} = n_D\\) and also applying the factor of 2 overcounts the rate by a factor of 4."
      }
    ]
  },
  {
    "id": "prc-16-2",
    "column": "left",
    "title": "Equation 16-2: Fusion Particle Number Density",
    "equations": [
      "\\[n_{tar} = n_{bomb} = \\frac{n_{tot}}{2}\\]"
    ],
    "variables": [
      {
        "sym": "\\(n_{tar}\\)",
        "def": "Number density of target particles [particles/cm<sup>3</sup>]"
      },
      {
        "sym": "\\(n_{bomb}\\)",
        "def": "Number density of bombarding particles [particles/cm<sup>3</sup>]"
      },
      {
        "sym": "\\(n_{tot}\\)",
        "def": "Total particle number density [particles/cm<sup>3</sup>]"
      }
    ],
    "description": [
      {
        "p": "If the bombarding and target nuclei are in equal ratio, such as D-D reactions or balanced D-T reactions, each species has equal number density at half the total number density. For D-D, remember the factor of 2 in Equation 16-1 when using these halves."
      }
    ]
  },
  {
    "id": "prc-17",
    "column": "left",
    "title": "Equation 17: D-D Fusion Reactivity",
    "equations": [
      "\\[\\langle \\sigma v \\rangle_{DD} = 2.33 \\times 10^{-14} E^{-2/3} e^{-18.76 E^{-1/3}}\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\langle \\sigma v \\rangle_{DD}\\)",
        "def": "D-D reactivity [cm<sup>3</sup>/s]"
      },
      {
        "sym": "\\(E\\)",
        "def": "Ion temperature [keV]"
      }
    ],
    "description": [
      {
        "p": "Simplified temperature-dependent reactivity for deuterium-deuterium fusion reactions. This parameterization provides the reaction rate coefficient as a function of plasma temperature ONLY for temperatures <25 keV."
      }
    ]
  },
  {
    "id": "prc-18",
    "column": "left",
    "title": "Equation 18: D-T Fusion Reactivity",
    "equations": [
      "\\[\\langle \\sigma v \\rangle_{DT} = 3.68 \\times 10^{-12} E^{-2/3} e^{-19.94 E^{-1/3}}\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\langle \\sigma v \\rangle_{DT}\\)",
        "def": "D-T reactivity [cm<sup>3</sup>/s]"
      },
      {
        "sym": "\\(E\\)",
        "def": "Ion temperature [keV]"
      }
    ],
    "description": [
      {
        "p": "Simplified temperature-dependent reactivity for deuterium-tritium fusion reactions. This parameterization provides the reaction rate coefficient as a function of plasma temperature ONLY for temperatures <25 keV."
      }
    ]
  },
  {
    "id": "prc-19",
    "column": "right",
    "title": "Equation 19: X-Ray Spectrum",
    "equations": [
      "\\[S_x(h\\nu) = Y_{ST} P(h\\nu, T_{ST}) + Y_{RR} P(h\\nu, T_{RR})\\]"
    ],
    "variables": [
      {
        "sym": "\\(S_x(h\\nu)\\)",
        "def": "Total x-ray spectrum per photon energy [J/keV]"
      },
      {
        "sym": "\\(Y_{ST}\\)",
        "def": "Shine through x-ray yield [J]"
      },
      {
        "sym": "\\(Y_{RR}\\)",
        "def": "Case re-radiation x-ray yield [J]"
      },
      {
        "sym": "\\(P(h\\nu, T)\\)",
        "def": "Normalized Planckian spectrum at temperature T [1/keV]"
      },
      {
        "sym": "\\(h\\nu\\)",
        "def": "Photon energy [keV]"
      },
      {
        "sym": "\\(T_{ST}\\)",
        "def": "Shine through temperature [K]"
      },
      {
        "sym": "\\(T_{RR}\\)",
        "def": "Case re-radiation temperature [K]"
      }
    ],
    "description": [
      {
        "p": "The total X-ray spectrum from a nuclear explosion is a combination of the shine through and case re-radiation x-ray components. They are found by multiplying the yield of each component by its respective Planckian spectrum."
      }
    ]
  },
  {
