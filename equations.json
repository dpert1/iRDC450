  {
    "id": "prc-21",
    "column": "right",
    "title": "Equation 21: Planck Group Integral",
    "equations": [
      "\\[P_g = \\int_{h\\nu_{g-1}}^{h\\nu_g} \\frac{15}{(\\pi k T)^4} \\frac{(h\\nu)^3}{\\exp\\left(\\frac{h\\nu}{kT}\\right) - 1} d(h\\nu)\\]"
    ],
    "variables": [
      {
        "sym": "\\(P_g\\)",
        "def": "Fraction of blackbody radiation energy in energy group g [-]"
      },
      {
        "sym": "\\(h\\nu\\)",
        "def": "Photon energy [keV]"
      },
      {
        "sym": "\\(h\\nu_g\\)",
        "def": "Upper energy boundary of group g [keV]"
      },
      {
        "sym": "\\(h\\nu_{g-1}\\)",
        "def": "Lower energy boundary of group g [keV]"
      },
      {
        "sym": "\\(k\\)",
        "def": "Boltzmann constant [keV/K]"
      },
      {
        "sym": "\\(T\\)",
        "def": "Temperature [K]"
      }
    ],
    "description": [
      {
        "p": "Integration of the Planck distribution over an energy group to determine the fraction of blackbody radiation in that group for multi-group x-ray transport calculations."
      }
    ]
  },
  {
    "id": "prc-22",
    "column": "right",
    "title": "Equation 22: Energy Deposition",
    "equations": [
      "\\[E_{dep}(x) = \\sum_{g=1}^{G} \\left[P_g F_0 e^{-\\mu_g x} \\left(\\frac{\\mu_a}{\\rho}\\right)_g\\right]\\]"
    ],
    "variables": [
      {
        "sym": "\\(E_{dep}(x)\\)",
        "def": "Energy deposited per unit mass at depth x [J/kg]"
      },
      {
        "sym": "\\(G\\)",
        "def": "Total number of energy groups [-]"
      },
      {
        "sym": "\\(P_g\\)",
        "def": "Fraction of incident energy in group g [-]"
      },
      {
        "sym": "\\(F_0\\)",
        "def": "Incident fluence [J/m<sup>2</sup>]"
      },
      {
        "sym": "\\(\\mu_g\\)",
        "def": "Total attenuation coefficient for group g [m<sup>-1</sup>]"
      },
      {
        "sym": "\\(x\\)",
        "def": "Depth [m]"
      },
      {
        "sym": "\\((\\mu_a/\\rho)_g\\)",
        "def": "Mass absorption coefficient for group g [m<sup>2</sup>/kg]"
      }
    ],
    "description": [
      {
        "p": "Multi-group calculation of energy deposited in a material by X-rays as a function of depth, accounting for exponential attenuation in each energy group."
      }
    ]
  },
  {
    "id": "prc-23",
    "column": "right",
    "title": "Equation 23: Pressure from Energy Deposition",
    "equations": [
      "\\[p(x) = E_{dep}(x) \\rho_0\\]"
    ],
    "variables": [
      {
        "sym": "\\(p(x)\\)",
        "def": "Pressure at depth x [Pa]"
      },
      {
        "sym": "\\(E_{dep}(x)\\)",
        "def": "Energy deposited per unit mass at depth x [J/kg]"
      },
      {
        "sym": "\\(\\rho_0\\)",
        "def": "Material density [kg/m<sup>3</sup>]"
      }
    ],
    "description": [
      {
        "p": "Pressure generated in a material by X-ray energy deposition. The deposited energy per unit mass, multiplied by density, gives the pressure impulse."
      },
      {
        "p": "This assumes the energy is deposited instantaneously (before the material can expand) and a Gr&uuml;neisen parameter \\(\\Gamma = 1\\). The more general form is \\(p = \\Gamma \\rho_0 E_{dep}\\), where \\(\\Gamma\\) depends on the material."
      }
    ]
  },
