    "id": "prc-40",
    "column": "left",
    "title": "Equation 40: Integrated Residual Dose",
    "equations": [
      "\\[D \\approx \\dot{D}_1 \\int_{t_a}^{t_b} t^{-1.2} \\, dt\\]",
      "\\[D \\approx 5\\dot{D}_1 \\left( t_a^{-0.2} - t_b^{-0.2} \\right)\\]"
    ],
    "variables": [
      {
        "sym": "\\(D\\)",
        "def": "Integrated dose between times \\(t_a\\) and \\(t_b\\) [rads]"
      },
      {
        "sym": "\\(\\dot{D}_1\\)",
        "def": "Dose rate at t = 1 hour (unit time reference dose rate) [rad/hr]"
      },
      {
        "sym": "\\(t_a\\)",
        "def": "Start time [hours]"
      },
      {
        "sym": "\\(t_b\\)",
        "def": "End time [hours]"
      }
    ],
    "description": [
      {
        "p": "Integration of the residual radiation decay law to determine total accumulated dose between two times. The factor of 5 comes from integrating t<sup>-1.2</sup>."
      }
    ]
  },
  {
    "id": "prc-41",
    "column": "left",
    "title": "Equation 41: Exponential Attenuation",
    "equations": [
      "\\[I = I_0 e^{-\\mu x}\\]"
    ],
    "variables": [
      {
        "sym": "\\(I\\)",
        "def": "Transmitted intensity [particles/cm<sup>2</sup>&sdot;s]"
      },
      {
        "sym": "\\(I_0\\)",
        "def": "Initial intensity [particles/cm<sup>2</sup>&sdot;s]"
      },
      {
        "sym": "\\(\\mu\\)",
        "def": "Linear attenuation coefficient [cm<sup>-1</sup>]"
      },
      {
        "sym": "\\(x\\)",
        "def": "Material thickness [cm]"
      }
    ],
    "description": [
      {
        "p": "Beer-Lambert law describing exponential attenuation of radiation passing through matter. Applies to uncollided (narrow beam) radiation."
      }
    ]
  },
  {
    "id": "prc-42",
    "column": "left",
    "title": "Equation 42: Mass Attenuation Coefficient (Mixture)",
    "equations": [
      "\\[\\frac{\\mu}{\\rho} = \\sum_{i=1}^{n} \\omega_i \\left(\\frac{\\mu}{\\rho}\\right)_i \\quad \\left[\\frac{\\text{cm}^2}{\\text{g}}\\right]\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\mu/\\rho\\)",
        "def": "Mass attenuation coefficient of mixture [cm<sup>2</sup>/g]"
      },
      {
        "sym": "\\(\\omega_i\\)",
        "def": "Weight fraction of component i [-]"
      },
      {
        "sym": "\\((\\mu/\\rho)_i\\)",
        "def": "Mass attenuation coefficient of component i [cm<sup>2</sup>/g]"
      },
      {
        "sym": "\\(n\\)",
        "def": "Number of components [-]"
      }
    ],
    "description": [
      {
        "p": "Mixture rule for calculating mass attenuation coefficients from constituent materials weighted by their mass fractions."
      }
    ]
  },
  {
    "id": "prc-43-1",
    "column": "left",
    "title": "Equation 43-1: Linear Attenuation Coefficient",
    "equations": [
      "\\[\\mu = N\\sigma\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\mu\\)",
        "def": "Linear attenuation coefficient [cm<sup>-1</sup>]"
      },
      {
        "sym": "\\(N\\)",
        "def": "Number density [atoms/cm<sup>3</sup>]"
      },
      {
        "sym": "\\(\\sigma\\)",
        "def": "Microscopic cross section [cm<sup>2</sup>]"
      }
    ],
    "description": [
      {
        "p": "Relationship between photon linear attentuation coefficient and microscopic cross sections. 1 barn = 10<sup>-24</sup> cm<sup>2</sup>."
      }
    ]
  },
  {
    "id": "prc-43-2",
    "column": "left",
    "title": "Equation 43-2: Mean Free Path",
    "equations": [
      "\\[\\lambda = \\frac{1}{\\mu}\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\mu\\)",
        "def": "Linear attenuation coefficient [cm<sup>-1</sup>]"
      },
      {
        "sym": "\\(\\lambda\\)",
        "def": "Mean free path [cm]"
      }
    ],
    "description": [
      {
        "p": "The definition of mean free path is the inverse of the linear attenuation coefficient."
      }
    ]
  },
  {
    "id": "prc-44-1",
    "column": "left",
    "title": "Equation 44-1: Number Density",
    "equations": [
      "\\[N = \\frac{\\rho N_A}{M}\\]"
    ],
    "variables": [
      {
        "sym": "\\(N\\)",
        "def": "Number density [atoms/cm<sup>3</sup>]"
      },
      {
        "sym": "\\(\\rho\\)",
        "def": "Mass density [g/cm<sup>3</sup>]"
      },
      {
        "sym": "\\(N_A\\)",
        "def": "Avogadro's number [atoms/mol]"
      },
      {
        "sym": "\\(M\\)",
        "def": "Atomic or molecular mass [g/mol]"
      }
    ],
    "description": [
      {
        "p": "Calculation of number density from mass density and atomic mass."
      }
    ]
  },
  {
    "id": "prc-44-2",
    "column": "left",
    "title": "Equation 44-2: Macroscopic Cross Section",
    "equations": [
      "\\[\\Sigma = N\\sigma\\]"
    ],
    "variables": [
      {
        "sym": "\\(\\Sigma\\)",
        "def": "Macroscopic cross section [cm<sup>-1</sup>]"
      },
      {
        "sym": "\\(N\\)",
        "def": "Number density [atoms/cm<sup>3</sup>]"
      },
      {
        "sym": "\\(\\sigma\\)",
        "def": "Microscopic cross section [cm<sup>2</sup>]"
      }
    ],
    "description": [
      {
        "p": "Calculation of neutron macroscopic cross section from number density and microscopic cross section."
      }
    ]
  }
]
